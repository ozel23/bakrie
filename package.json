{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write resources/js resources/css/app.css mobile/App.tsx mobile/src mobile/tests vite.config.js",
    "format:check": "prettier --check resources/js resources/css/app.css mobile/App.tsx mobile/src mobile/tests vite.config.js"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.3",
    "laravel-vite-plugin": "^3.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  },
  "name": "epita-web",
  "dependencies": {
    "@inertiajs/react": "^3.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0"
  }
